{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.fasttrack_k7n2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070A07"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://fasttra-l8svt9q-preview-4200.runable.site/",
      "applicationId": "fasttra-l8svt9q",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.fasttrack_k7n2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A07"
    },
    "name": "FastTrack",
    "slug": "fasttrack",
    "version": "1.0.0",
    "scheme": "runable-fasttra-l8svt9q",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
